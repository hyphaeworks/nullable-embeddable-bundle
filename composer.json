{
    "name": "hyphaeworks/nullable-embeddable-bundle",
    "description": "Symfony bundle for handling nullable Doctrine embeddables",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "symfony-bundle", "doctrine", "doctrine-orm", "embeddable", "nullable", "value-object"],
    "homepage": "https://github.com/hyphaeworks/nullable-embeddable-bundle",
    "authors": [
        {
            "name": "Wolfgang Klinger"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8.0",
        "doctrine/orm": "^2.17 || ^3.0",
        "doctrine/doctrine-bundle": "^2.12 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Hyphaeworks\\NullableEmbeddableBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyphaeworks\\NullableEmbeddableBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/error-handler": "^6.4.44 || ^7.4.17 || ^8.1.5"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "benchmark": "bin/benchmark",
        "cs:check": "./vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "./vendor/bin/php-cs-fixer fix",
        "phpstan": "./vendor/bin/phpstan analyse",
        "check-all": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
