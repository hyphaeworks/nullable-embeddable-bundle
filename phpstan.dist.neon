parameters:
    level: max
    paths:
        - src
        - tests
        - bin/benchmark
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # ORM 2 maps embeddables as arrays; ORM 3 as EmbeddedClassMapping
        -
            identifier: instanceof.alwaysTrue
            path: src/Doctrine/MappedEmbeddedProperty.php
            count: 1
