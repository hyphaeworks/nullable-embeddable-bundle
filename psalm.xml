<?xml version="1.0"?>
<psalm
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
        errorLevel="1"
        findUnusedCode="false"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <!-- Symfony 8.1 moved and renamed the bundle API; older versions need the old one -->
        <DeprecatedInterface>
            <errorLevel type="suppress">
                <file name="src/NullableEmbeddableBundle.php"/>
            </errorLevel>
        </DeprecatedInterface>
        <ParamNameMismatch>
            <errorLevel type="suppress">
                <file name="src/NullableEmbeddableBundle.php"/>
            </errorLevel>
        </ParamNameMismatch>
    </issueHandlers>
</psalm>
